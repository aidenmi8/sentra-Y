# Sentra Mi8 - Environment Variables
# Copy this file to .env.local or .env and fill in only what you need.
# Core map/feed layers work without subscription keys.

# AI Intelligence Layer (optional)
# Get keys at https://aistudio.google.com/apikey
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=
# GEMINI_API_KEY_8=

# Live maritime AIS (optional)
# AIS_API_KEY=

# RECON scanner backend (optional; both values required to enable /api/scanner)
# SCANNER_URL=http://your-scanner:7700
# SCANNER_KEY=

# External SDK ingest (optional; required to accept /api/sdk/ingest writes)
# SDK_INGEST_KEY=

# GitHub webhook bridge (optional; both values required to enable forwarding)
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_FORWARD_URL=

# Umami analytics (optional; both values required to emit analytics events)
# UMAMI_ENDPOINT=
# UMAMI_WEBSITE_ID=

# Runtime/feed overrides (optional)
# SENTRA_MI8_INTEL_URL=
# SENTRA_MI8_TELEGRAM_CHANNELS=OSINTtechnical,Faytuks,Liveuamap,CyberKnow
# IPTV_ORG_BASE_URL=https://iptv-org.github.io

# Planned/reserved provider keys. Current routes do not consume these yet.
# FIRMS_API_KEY=
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# N2YO_API_KEY=
