# Sentra Mi8 - Environment Template
# Copy this file to `.env` for Docker or `.env.local` for local Next.js runs.
#
# Core feeds work without subscriptions:
# adsb.lol, public TLE feeds, NASA FIRMS open CSV, USGS, NOAA, EONET,
# public RSS/Telegram previews, OpenSanctions mirrors, Blockstream,
# Blockscout, and IPTV-org.
#
# Check runtime status with:
#   curl http://localhost:3005/api/provider-health

# ---------------------------------------------------------------------------
# AI Intelligence Layer
# ---------------------------------------------------------------------------
# Optional. Powers /api/ai/analyze and /api/ai/briefing when configured.
# Multiple keys enable server-side rotation.
# Get keys: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

# ---------------------------------------------------------------------------
# RECON Scanner Backend
# ---------------------------------------------------------------------------
# Optional. Both SCANNER_URL and SCANNER_KEY are required to enable /api/scanner.
# SCANNER_KEY must match the scanner backend's SENTRA_MI8_KEY.
# Generate a shared key with:
#   openssl rand -hex 32
# Deprecated backend alias during migration: OSIRIS_KEY.
SCANNER_URL=
SCANNER_KEY=

# ---------------------------------------------------------------------------
# Live Maritime AIS
# ---------------------------------------------------------------------------
# Optional. Enables the aisstream.io WebSocket subscription in /api/maritime.
# Get a key: https://aisstream.io/
AIS_API_KEY=

# ---------------------------------------------------------------------------
# External SDK Ingest
# ---------------------------------------------------------------------------
# Optional. Required for /api/sdk/ingest to accept writes.
# Without this key, SDK ingest returns 503 instead of accepting dev defaults.
SDK_INGEST_KEY=

# ---------------------------------------------------------------------------
# GitHub Webhook Bridge
# ---------------------------------------------------------------------------
# Optional. Both values are required to enable /api/github-webhook forwarding.
# GITHUB_WEBHOOK_SECRET must match the GitHub webhook secret.
# GITHUB_WEBHOOK_FORWARD_URL is the internal bot/bridge endpoint to forward to.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_FORWARD_URL=

# ---------------------------------------------------------------------------
# Umami Analytics
# ---------------------------------------------------------------------------
# Optional. Both values are required; otherwise middleware makes no analytics
# network calls.
UMAMI_ENDPOINT=
UMAMI_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Runtime and Feed Overrides
# ---------------------------------------------------------------------------
# Host port the web UI is published on by docker-compose.yml.
SENTRA_MI8_PORT=3000
# Deprecated compatibility alias:
# OSIRIS_PORT=3000

# Host port published by docker-compose.local.yml.
# LOCAL_SENTRA_MI8_PORT=3005
# Deprecated compatibility alias:
# LOCAL_OSIRIS_PORT=3005

# Optional Intel service override for /api/entity/expand.
# Defaults are environment-dependent when unset.
SENTRA_MI8_INTEL_URL=
# Deprecated compatibility alias:
# OSIRIS_INTEL_URL=

# Comma-separated public Telegram channel usernames, no @.
# Defaults when unset: OSINTtechnical,Faytuks,Liveuamap,CyberKnow
SENTRA_MI8_TELEGRAM_CHANNELS=
# Deprecated compatibility alias:
# OSIRIS_TELEGRAM_CHANNELS=

# IPTV-org playlist/API source. Leave unset unless testing a mirror.
# Sentra Mi8 links to public streams; it does not host or proxy IPTV video.
# IPTV_ORG_BASE_URL=https://iptv-org.github.io

# Set by the Docker image already - override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# ---------------------------------------------------------------------------
# Provider credential admin (optional, OFF by default)
#
# Set to exactly "true" to expose /admin/providers and /api/admin/providers,
# a keyless page for setting provider API keys at runtime. It carries no
# password, so it is deliberately restricted: the routes refuse any request
# whose Host header is not a loopback address, refuse cross-origin requests,
# and require an x-sentra-admin header on writes.
#
# Leave this unset for any deployment reachable from a network. Values saved
# through it are written to config/providers.local.json (gitignored) and layer
# over the variables below without replacing them.
# ---------------------------------------------------------------------------
ENABLE_PROVIDER_ADMIN=

# ---------------------------------------------------------------------------
# Worldwide cameras
#
# OpenStreetMap surveillance positions are keyless and need nothing here — they
# are camera LOCATIONS worldwide (ODbL), not viewable feeds.
#
# Windy supplies the watchable public webcams. Free key: https://api.windy.com/keys
# Without it, /api/cameras/worldwide still serves OSM positions and the existing
# traffic-authority feeds. Can also be set at runtime from /admin/providers.
# ---------------------------------------------------------------------------
WINDY_API_KEY=

# ---------------------------------------------------------------------------
# Aviation tracking
# OpenSky is the primary /api/flights source when both values are set.
# adsb.lol remains the keyless fallback when OpenSky is unavailable.
# ---------------------------------------------------------------------------
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Planned / Reserved Provider Keys
# ---------------------------------------------------------------------------
# These are documented for future adapters and provider-health visibility.
# Current routes do not consume them yet.
FIRMS_API_KEY=
N2YO_API_KEY=
